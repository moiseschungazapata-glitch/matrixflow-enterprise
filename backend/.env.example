APP_NAME="MatrixFlow Enterprise API"
APP_VERSION="1.0.0"
ENVIRONMENT="development"
API_PREFIX="/api/v1"

# SQLite local. Conserva esta opción para desarrollo y Swagger local.
DATABASE_URL="sqlite:///./matrixflow.db"
AUTO_CREATE_TABLES=true
SEED_DEMO_USERS=true

# PostgreSQL / Supabase (ejemplo; nunca publiques credenciales reales):
# DATABASE_URL="postgresql+psycopg://usuario:clave@host:5432/matrixflow?sslmode=require"
# En un entorno administrado con Alembic usa AUTO_CREATE_TABLES=false.

# Pydantic Settings interpreta esta variable como una lista JSON.
CORS_ORIGINS='["http://localhost:5173","http://127.0.0.1:5173"]'
CORS_ALLOW_CREDENTIALS=true

# Reemplazar por un valor largo y aleatorio fuera del entorno local.
JWT_SECRET_KEY="change-this-secret-before-production"
JWT_ALGORITHM="HS256"
JWT_ISSUER="matrixflow-enterprise"
JWT_AUDIENCE="matrixflow-frontend"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Úsalo temporalmente para registrar el primer rostro y desactívalo después.
ALLOW_LEGACY_LOGIN=true

# Verificación biométrica con recursos exclusivos de MatrixFlow.
# Boto3 toma AWS_ACCESS_KEY_ID y AWS_SECRET_ACCESS_KEY del entorno.
AWS_FACE_LIVENESS_ENABLED=false
AWS_REGION="us-east-1"
AWS_REKOGNITION_COLLECTION_ID="matrixflow-users"
FACE_LIVENESS_THRESHOLD=90
FACE_MATCH_THRESHOLD=95
FACE_VERIFICATION_EXPIRE_MINUTES=3
FACE_MAX_ATTEMPTS=5
FACE_ATTEMPT_WINDOW_MINUTES=30

# Configura estos dos secretos únicamente en el entorno local seguro o Vercel.
# Nunca los publiques ni uses el prefijo VITE_.
# AWS_ACCESS_KEY_ID="..."
# AWS_SECRET_ACCESS_KEY="..."
