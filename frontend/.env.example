VITE_API_URL=http://localhost:8000/api/v1

# Datos públicos del recurso Cognito exclusivo de MatrixFlow.
# No son access keys ni secretos.
VITE_AWS_REGION=us-east-1
VITE_AWS_COGNITO_IDENTITY_POOL_ID=us-east-1:xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Habilitar sólo durante el registro inicial de rostros.
VITE_ALLOW_LEGACY_LOGIN=true
